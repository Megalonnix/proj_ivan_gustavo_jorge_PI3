<<dados, include=FALSE>>=
docs_df <- read.csv("entrega-1-docs.csv", fileEncoding = "UTF-8", stringsAsFactors = FALSE)
pag     <- read.csv("entrega-1-paginas.csv", fileEncoding = "UTF-8", stringsAsFactors = FALSE)
met     <- read.csv("entrega-1-metodos.csv", fileEncoding = "UTF-8", stringsAsFactors = FALSE)
rk      <- read.csv("entrega-1-rankings.csv", fileEncoding = "UTF-8", stringsAsFactors = FALSE)
top     <- read.csv("entrega-1-top10.csv", fileEncoding = "UTF-8", stringsAsFactors = FALSE)
res     <- read.csv("entrega-1-resultados.csv", fileEncoding = "UTF-8", stringsAsFactors = FALSE)
r       <- setNames(res$valor, res$medida)

f1 <- function(x, d = 1) formatC(x, format = "f", digits = d, big.mark = ".", decimal.mark = ",")
f0 <- function(x) formatC(as.integer(round(x)), format = "d", big.mark = ".")

tex <- function(x) {
  x <- gsub("\\\\", "\\\\textbackslash{}", x)
  x <- gsub("([%&_#$])", "\\\\\\1", x)
  x <- gsub("([{}])", "\\\\\\1", x)
  x <- gsub("~", "\\\\textasciitilde{}", x)
  x <- gsub("\\^", "\\\\textasciicircum{}", x)
  x
}

tam_bruto <- setNames(docs_df$n_tokens_bruto, docs_df$id)
texto_top10 <- paste0("\\texttt{", tex(top$termo), "} (", top$n, ")", collapse = ", ")
texto_pag   <- paste0("\\textit{", pag$pagina_tex, "}: ", pag$documentos, " de ", pag$brutos,
                      " (", f1(pag$pct, 1), "\\%, m\\'edia ", f1(pag$tokens_bruto, 1), " tokens)", collapse = "; ")

m  <- function(cq, me, col) met[met$consulta == cq & met$metodo == me, col]
nd <- function(cq, me) f1(m(cq, me, "ndcg"), 2)
ms_med <- tapply(met$ms, met$metodo, mean)
@

